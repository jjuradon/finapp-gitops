# Server
APP_ENV=homelab
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Database (one per module schema)
DB_URL_AUTH=postgresql+asyncpg://finapp_auth:secret@localhost:5432/finapp
DB_URL_ACCOUNT=postgresql+asyncpg://finapp_account:secret@localhost:5432/finapp
DB_URL_TRANSACTION=postgresql+asyncpg://finapp_transaction:secret@localhost:5432/finapp
DB_URL_PLANNING=postgresql+asyncpg://finapp_planning:secret@localhost:5432/finapp
DB_URL_CATEGORISATION=postgresql+asyncpg://finapp_categorisation:secret@localhost:5432/finapp
DB_URL_ANALYTICS=postgresql+asyncpg://finapp_analytics:secret@localhost:5432/finapp

# Message broker
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
AUTH_PRIVATE_KEY=
AUTH_PUBLIC_KEY=
