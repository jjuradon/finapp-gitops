# .env.example (finapp-gitops)

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Superuser password for the PostgreSQL container. Used by Docker Compose only.
POSTGRES_PASSWORD=changeme

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Default user credentials for the RabbitMQ container.
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=changeme

# ── Backend source mount ───────────────────────────────────────────────────────
# Absolute or relative path to your local finapp-backend clone.
# docker-compose.override.yml mounts this path into the backend container
# so uvicorn --reload picks up code changes without rebuilding the image.
BACKEND_PATH=../finapp-backend
